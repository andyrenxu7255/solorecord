SOLO_BASE_URL=http://127.0.0.1:8000
SOLO_SECRET_KEY=change-me-before-production
SOLO_DATA_DIR=var
SOLO_DATABASE_PATH=var/solorecord.db
SOLO_STORAGE_DIR=var/storage
SOLO_APK_DIR=var/apk
SOLO_STATIC_DIR=server/static
SOLO_ALLOW_DEMO_LOGIN=true

# 群晖 LDAP 登录
# Synology LDAP login
SOLO_LDAP_ENABLED=false
SOLO_LDAP_SERVER=
SOLO_LDAP_BIND_DN_TEMPLATE=
SOLO_LDAP_LOOKUP_BIND_DN=
SOLO_LDAP_LOOKUP_BIND_PASSWORD=
SOLO_LDAP_SEARCH_DN=
SOLO_LDAP_SEARCH_FILTER=(cn={username})
SOLO_LDAP_USERNAME_KEY=cn
SOLO_LDAP_EMAIL_KEY=mail
SOLO_LDAP_EMAIL_POSTFIX=
SOLO_LDAP_DISPLAY_NAME_KEY=displayName
SOLO_LDAP_ADMIN_USERS=
SOLO_LDAP_ADMIN_GROUP_DN=
SOLO_LDAP_DEFAULT_ROLE=user
SOLO_LDAP_TLS_VALIDATE=true
SOLO_LDAP_TIMEOUT_SECONDS=10

# 群晖 SSO / 公司统一登录，可选
# Synology SSO / company unified login, optional
SOLO_SSO_VERIFY_MODE=demo
SOLO_SSO_ISSUER=
SOLO_SSO_CLIENT_ID=
SOLO_SSO_CLIENT_SECRET=
SOLO_SSO_REDIRECT_URI=
SOLO_SSO_SCOPE=openid email
SOLO_SSO_AUTHORIZE_URL=
SOLO_SSO_TOKEN_URL=
SOLO_SSO_USERINFO_URL=
SOLO_SSO_JWKS_URL=
SOLO_SSO_INTROSPECTION_URL=
SOLO_SSO_TICKET_VERIFY_URL=

# ASR/LLM 默认值。mock 模式可在模型部署前保持系统可运行。
# ASR/LLM defaults. mock keeps the system runnable before model deployment.
SOLO_ASR_PROVIDER=mock
SOLO_ASR_COMMAND=
SOLO_ASR_TIMEOUT_SECONDS=3600
SOLO_AUDIO_SEGMENT_MINUTES=5
SOLO_TARGET_SAMPLE_RATE=16000
SOLO_ENABLE_DIARIZATION=true
SOLO_ENABLE_DENOISE=false
SOLO_LLM_PROVIDER=mock
SOLO_LLM_ENDPOINT=
SOLO_LLM_API_KEY=
SOLO_LLM_MODEL=

SOLO_HERMES_WEBHOOK_URL=
SOLO_HERMES_WEBHOOK_TOKEN=

# 可选 Elasticsearch/OpenSearch 索引和外部系统集成。
# Optional Elasticsearch/OpenSearch indexing and external integrations.
SOLO_ES_ENABLED=false
SOLO_ES_URL=
SOLO_ES_INDEX=solorecord_meetings
SOLO_ES_API_KEY=
SOLO_ES_USERNAME=
SOLO_ES_PASSWORD=
SOLO_EXTERNAL_API_TOKENS=

# 仅启用 docker-compose 可选 full profile 时需要。
# 这些变量由可选 Postgres/MinIO 容器读取。
# Only needed when enabling the optional docker-compose "full" profile.
# These names are consumed by the optional Postgres/MinIO containers.
POSTGRES_USER=solorecord
POSTGRES_PASSWORD=replace-with-long-random-password
MINIO_ROOT_USER=solorecord
MINIO_ROOT_PASSWORD=replace-with-long-random-password
